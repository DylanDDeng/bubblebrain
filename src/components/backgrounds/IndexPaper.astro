---
---
<div class="index-paper-bg" aria-hidden="true">
  <div class="index-paper-rail index-paper-rail-left">
    <i style="--y: 10%; --w: 3.8rem"></i>
    <i style="--y: 21%; --w: 2.4rem"></i>
    <i style="--y: 37%; --w: 5.2rem"></i>
    <i style="--y: 54%; --w: 3rem"></i>
    <i style="--y: 74%; --w: 4.4rem"></i>
  </div>

  <div class="index-paper-rail index-paper-rail-right">
    <i style="--y: 14%; --w: 4.8rem"></i>
    <i style="--y: 29%; --w: 2.6rem"></i>
    <i style="--y: 47%; --w: 5.8rem"></i>
    <i style="--y: 66%; --w: 3.4rem"></i>
    <i style="--y: 83%; --w: 4.2rem"></i>
  </div>

  <div class="index-paper-cluster index-paper-cluster-top">
    <span class="index-paper-pin"></span>
    <span class="index-paper-line index-paper-line-long"></span>
    <span class="index-paper-line"></span>
    <span class="index-paper-line index-paper-line-short"></span>
  </div>

  <div class="index-paper-cluster index-paper-cluster-bottom">
    <span class="index-paper-line index-paper-line-short"></span>
    <span class="index-paper-line index-paper-line-long"></span>
    <span class="index-paper-pin"></span>
  </div>

  <div class="index-paper-card index-paper-card-left">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="index-paper-card index-paper-card-right">
    <span></span>
    <span></span>
    <span></span>
  </div>
</div>

<style>
  .index-paper-bg {
    --index-paper-ink: 87 83 76;
    --index-paper-accent: 111 143 138;
    --index-paper-fill: 255 255 252;
    --index-paper-line: rgb(var(--index-paper-ink) / 0.1);
    --index-paper-soft: rgb(var(--index-paper-ink) / 0.055);
    --index-paper-accent-line: rgb(var(--index-paper-accent) / 0.16);
    --index-paper-row-height: 2.4rem;

    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .index-paper-bg::before {
    position: absolute;
    inset: 0;
    content: '';
    background:
      /* 笔记本横线纸纹 */
      repeating-linear-gradient(
        to bottom,
        transparent,
        transparent calc(var(--index-paper-row-height) - 1px),
        var(--index-paper-line) var(--index-paper-row-height)
      ),
      linear-gradient(
        90deg,
        transparent calc(50% - 31.5rem),
        var(--index-paper-soft) calc(50% - 31.5rem),
        var(--index-paper-soft) calc(50% - 31.45rem),
        transparent calc(50% - 31.45rem)
      ),
      linear-gradient(
        90deg,
        transparent calc(50% + 29.6rem),
        var(--index-paper-soft) calc(50% + 29.6rem),
        var(--index-paper-soft) calc(50% + 29.65rem),
        transparent calc(50% + 29.65rem)
      );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 10%,
      black 88%,
      transparent
    );
  }

  .index-paper-bg::after {
    position: absolute;
    inset: 5rem max(2rem, calc(50% - 34rem)) 4rem;
    content: '';
    border-top: 1px solid var(--index-paper-soft);
    border-bottom: 1px solid var(--index-paper-soft);
    opacity: 0.5;
  }

  .index-paper-rail {
    position: absolute;
    top: 7rem;
    bottom: 5rem;
    width: 9rem;
    opacity: 0.72;
  }

  .index-paper-rail-left {
    left: max(1.5rem, calc(50% - 39rem));
    border-left: 1px solid var(--index-paper-line);
  }

  .index-paper-rail-right {
    right: max(1.5rem, calc(50% - 39rem));
    border-right: 1px solid var(--index-paper-line);
  }

  .index-paper-rail i {
    position: absolute;
    top: var(--y);
    width: var(--w);
    height: 1px;
    background: var(--index-paper-line);
  }

  .index-paper-rail i::after {
    position: absolute;
    top: -0.18rem;
    width: 0.36rem;
    height: 0.36rem;
    content: '';
    border: 1px solid var(--index-paper-accent-line);
    background: rgb(var(--index-paper-fill) / 0.72);
  }

  .index-paper-rail-left i {
    left: 0;
  }

  .index-paper-rail-left i::after {
    right: -0.18rem;
  }

  .index-paper-rail-right i {
    right: 0;
  }

  .index-paper-rail-right i::after {
    left: -0.18rem;
  }

  .index-paper-cluster {
    position: absolute;
    display: grid;
    gap: 0.55rem;
    width: 15rem;
    opacity: 0.72;
  }

  .index-paper-cluster-top {
    top: 5.3rem;
    left: max(2rem, calc(50% - 27.5rem));
  }

  .index-paper-cluster-bottom {
    right: max(2rem, calc(50% - 34rem));
    bottom: 9rem;
  }

  .index-paper-line {
    display: block;
    width: 8.5rem;
    height: 1px;
    background: var(--index-paper-line);
  }

  .index-paper-line-long {
    width: 14rem;
  }

  .index-paper-line-short {
    width: 5rem;
  }

  .index-paper-pin {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--index-paper-accent-line);
    background: rgb(var(--index-paper-fill) / 0.78);
  }

  .index-paper-card {
    position: absolute;
    display: grid;
    gap: 0.7rem;
    width: 11rem;
    padding: 1.1rem 1rem;
    border-top: 1px solid var(--index-paper-soft);
    border-left: 1px solid var(--index-paper-soft);
    opacity: 0.42;
  }

  .index-paper-card span {
    display: block;
    height: 1px;
    background: var(--index-paper-line);
  }

  .index-paper-card span:nth-child(2) {
    width: 72%;
  }

  .index-paper-card span:nth-child(3) {
    width: 46%;
  }

  .index-paper-card-left {
    bottom: 13rem;
    left: max(2rem, calc(50% - 35rem));
  }

  .index-paper-card-right {
    top: 19rem;
    right: max(2rem, calc(50% - 37rem));
  }

  html.dark .index-paper-bg {
    --index-paper-ink: 225 222 214;
    --index-paper-accent: 157 181 176;
    --index-paper-fill: 24 25 27;

    opacity: 0.68;
  }

  @media (max-width: 1023.9px) {
    .index-paper-bg::after,
    .index-paper-card,
    .index-paper-cluster-bottom {
      display: none;
    }

    .index-paper-rail {
      width: 5.5rem;
      opacity: 0.52;
    }

    .index-paper-rail-left {
      left: 0.9rem;
    }

    .index-paper-rail-right {
      right: 0.9rem;
    }

    .index-paper-cluster-top {
      top: 5.1rem;
      left: 1.5rem;
      width: 10rem;
      opacity: 0.45;
    }
  }

  @media (max-width: 767.9px) {
    .index-paper-bg::before,
    .index-paper-rail {
      display: none;
    }

    .index-paper-cluster-top {
      top: 5.15rem;
      left: 1.5rem;
      width: 8.5rem;
      opacity: 0.3;
    }

    .index-paper-line {
      width: 5.8rem;
    }

    .index-paper-line-long {
      width: 8.5rem;
    }

    .index-paper-line-short {
      width: 3.2rem;
    }
  }
</style>
